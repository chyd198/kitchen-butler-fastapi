# Moonshot (Kimi) API — https://platform.moonshot.cn
# LangChain's ChatOpenAI reads these two variables automatically.
OPENAI_API_KEY=sk-your-moonshot-key
OPENAI_BASE_URL=https://api.moonshot.cn/v1

# Tavily web search — https://app.tavily.com
TAVILY_API_KEY=tvly-your-tavily-key

# LangSmith observability (optional, required for langsmith_dev.ipynb)
# https://smith.langchain.com → Settings → API Keys
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_pt_your-langsmith-key
LANGSMITH_PROJECT=ai-kitchen-butler
